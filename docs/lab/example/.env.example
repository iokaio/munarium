# Copy to .env and fill every value. Keep .env out of version control.
# Use long alphanumeric values: the database password is embedded in a URI,
# and the signing secret must be at least 32 bytes.
POSTGRES_PASSWORD=
MUNARIUM_RW_TOKEN=
MUNARIUM_MGMT_TOKEN=
MUNARIUM_TOKEN_SECRET=
# Host port for the REST API (loopback only).
LAB_HOST_PORT=8080
