        ],
        "type": "object"
      },
      "IntrospectResponse": {
        "description": "What `introspect` proved about the role, plus what it found in the schema.",
        "properties": {
          "draft_contract_yaml": {
            "description": "A skeleton the operator edits, never applied automatically.",
            "type": [
              "string",
              "null"
            ]
          },
          "posture": {
            "$ref": "#/components/schemas/RolePostureReport"
          },
          "schema_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/TableInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "source",
          "posture"
        ],
        "type": "object"
      },
      "JobAccepted": {
        "description": "A queued job. Returned by the enqueue routes so a caller has something to\nwatch — a 202 with no id would leave an operator guessing.",
        "properties": {
          "accepted": {
            "minimum": 0,
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "jobs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "jobs",
          "detail"
        ],
        "type": "object"
      },
      "JournalEntry": {
        "description": "One journal row. Parameters and results are **redacted by default**; an\nexplicit reveal is itself journaled.",
        "properties": {
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "asset_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "duration_ms": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "redacted": {
            "description": "True when parameters/results exist but are withheld.",
            "type": "boolean"
          },
          "refusal_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rows": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "seal_ms": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ms": {
            "description": "For an `execute` row: the source's\nown statement window and the canonicalize+seal call. `duration_ms`\nminus both is Matrix's own share — bind, compile, budget, transport.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "tenant": {
            "type": "string"
          },
          "via": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
