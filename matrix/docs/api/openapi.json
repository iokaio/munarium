{
  "components": {
    "schemas": {
      "ApplyResponse": {
        "properties": {
          "asset_ref": {
            "description": "`name@version`",
            "type": "string"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array"
          },
          "kind": {
            "type": "string"
          },
          "unchanged": {
            "description": "True when this apply changed nothing (byte-identical re-apply).",
            "type": "boolean"
          }
        },
        "required": [
          "asset_ref",
          "kind",
          "unchanged"
        ],
        "type": "object"
      },
      "AssetListResponse": {
        "properties": {
          "assets": {
            "items": {
              "$ref": "#/components/schemas/AssetSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "assets"
        ],
        "type": "object"
      },
      "AssetSummary": {
        "properties": {
          "asset_ref": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "asset_ref",
          "name",
          "version",
          "kind",
          "created_at"
        ],
        "type": "object"
      },
      "ColumnInfo": {
        "properties": {
          "logical_type": {
            "description": "The canon@1 type it maps to, or `None` when it maps to nothing (which\nis why the column cannot be used).",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "source_type": {
            "description": "The source's own type name, verbatim — before any mapping.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "source_type",
          "nullable"
        ],
        "type": "object"
      },
      "Finding": {
        "description": "A validation finding. `code` is the stable identity; the message is for a\nhuman and may be reworded without breaking a test.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ],
        "type": "object"
      },
      "GateHistory": {
        "description": "`GET /v1/mappings/{name}/gate-history` — the promotion gates over time.\n\nExists because the owner confirmed the 0.95 identity-precision threshold\n**with monitoring**: a number nobody can watch is a number nobody can\nrevise on evidence.",
        "properties": {
          "mapping": {
            "type": "string"
          },
          "min_identity_precision": {
            "format": "double",
            "type": "number"
          },
          "min_value_conformance": {
            "format": "double",
            "type": "number"
          },
          "passing": {
            "description": "How many of `runs` would pass the current thresholds. A ratio far from\n0 or 1 is the signal that a threshold is doing real work; 1.0 over a\nlong series means it is not binding, and 0.0 means it is a wall.",
            "minimum": 0,
            "type": "integer"
          },
          "runs": {
            "description": "Newest first.",
            "items": {
              "$ref": "#/components/schemas/GateHistoryEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "mapping",
          "min_identity_precision",
          "min_value_conformance",
          "runs",
          "passing"
        ],
        "type": "object"
      },
      "GateHistoryEntry": {
        "description": "One completed run's gate values, with the verdict the CURRENT thresholds\nwould give it.\n\n`would_pass` is computed against the thresholds in force right now, not the\nones in force when the run happened — which is the point. Lowering\n`MUNARIUM_MATRIX_PROMOTION_MIN_IDENTITY_PRECISION` and re-reading this\nseries shows exactly which past runs the change would have admitted, before\nanything is promoted under the new number.",
        "properties": {
          "ambiguous": {
            "format": "int64",
            "type": "integer"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity_margin": {
            "description": "Signed distance from the threshold. NEGATIVE means the run failed the\ngate; a small positive number is a near-miss worth knowing about, and is\ninvisible in a pass/fail column.",
            "format": "double",
            "type": "number"
          },
          "identity_precision": {
            "format": "double",
            "type": "number"
          },
          "nonconforming": {
            "format": "int64",
            "type": "integer"
          },
          "observations": {
            "format": "int64",
            "type": "integer"
          },
          "run_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "value_conformance": {
            "format": "double",
            "type": "number"
          },
          "value_margin": {
            "format": "double",
            "type": "number"
          },
          "would_pass": {
            "type": "boolean"
          }
        },
        "required": [
          "run_id",
          "state",
          "observations",
          "ambiguous",
          "nonconforming",
          "identity_precision",
          "value_conformance",
          "identity_margin",
          "value_margin",
          "would_pass"
        ],
        "type": "object"
      },
      "HealthDataResponse": {
        "properties": {
          "healthy": {
            "type": "boolean"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/ProbeResponse"
            },
            "type": "array"
          }
        },
        "required": [
