  "info": {
    "description": "The structured-evidence plane. Registers formal data sources, materializes governed record collections, executes verified query contracts, and seals typed evidence into munarium-server. The cross-tree contract with the server is matrix/contract/.",
    "title": "munarium-matrix",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/docs": {
      "get": {
        "responses": {
          "200": {
            "description": "html"
          }
        },
        "security": [],
        "summary": "Human landing page"
      }
    },
    "/healthdata": {
      "get": {
        "responses": {
          "200": {
            "description": "sources"
          }
        },
        "summary": "Per-source health (control role)"
      }
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "alive"
          }
        },
        "security": [],
        "summary": "Liveness"
      }
    },
    "/mcp": {
      "post": {
        "responses": {
          "200": {
            "description": "a JSON-RPC response; a refusal rides it as a tool error"
          }
        },
        "summary": "MCP (JSON-RPC 2.0): initialize, ping, tools/list, tools/call — pre-declared tools only, no free SQL"
      }
    },
    "/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "spec"
          }
        },
        "security": [],
        "summary": "This document"
      }
    },
    "/readyz": {
      "get": {
        "responses": {
          "200": {
            "description": "ready"
          },
          "503": {
            "description": "not ready or draining"
          }
        },
        "security": [],
        "summary": "Readiness (store probe; 503 while draining)"
      }
    },
    "/v1/assets": {
