      "PlannerAskRequest": {
        "description": "`POST /v1/datasources/{name}/planner/ask`.",
        "properties": {
          "mode": {
            "description": "`assist` (default) or `evaluation`. Spelled rather than a boolean: the\ntwo modes differ in what they REFUSE, and a flag would leave a reader\nguessing which way it points.",
            "type": [
              "string",
              "null"
            ]
          },
          "question": {
            "description": "The question, in words.",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      },
      "PlannerAskResponse": {
        "description": "The answer. Deliberately NOT an `EvidenceBlock`: nothing here is sealed,\nbecause nothing here was executed. An admitted proposal is run through a\ncontract, and it is that execution that produces citable evidence.",
        "properties": {
          "admitted_sql": {
            "description": "Present only when the allowlist admitted the proposal. Run it through a\ncontract; this route never executes.",
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "pin": {
            "description": "The pin: space, conversation, message, attachment, statement, query\nhash — and `pinned`, which is false everywhere today."
          },
          "plan_pinned": {
            "description": "Whether the PLAN is reproducible. It is not; the field exists so a\nreader is told rather than left to assume.",
            "type": "boolean"
          },
          "proposed_sql": {
            "type": [
              "string",
              "null"
            ]
          },
          "prose": {
            "type": [
              "string",
              "null"
            ]
          },
          "refusal": {},
          "source": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "mode",
          "pin",
          "plan_pinned",
          "note"
        ],
        "type": "object"
      },
