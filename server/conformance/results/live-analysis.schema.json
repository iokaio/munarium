{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13 local live campaign analysis v1",
  "type": "object",
  "required": ["schema_version", "kind", "id", "manifest_id", "raw_id", "grading_id", "source", "governance", "calibration"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "live_analysis"},
    "id": {"$ref": "#/$defs/identity"}, "manifest_id": {"$ref": "#/$defs/identity"},
    "raw_id": {"$ref": "#/$defs/identity"}, "grading_id": {"$ref": "#/$defs/identity"},
    "source": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/identity"}},
    "governance": {
      "type": "object", "required": ["d6_verdict", "per_arm", "independent_histories", "paired_difference", "paired_bootstrap_95", "model_quality_qualified", "paired_history_differences"],
      "properties": {
        "d6_verdict": {"enum": ["qualified", "rejected", "inconclusive", "incomplete", "diagnostic_only"]},
        "per_arm": {"type": "object", "required": ["no_memory", "versioned_notes", "conventional_retrieval", "munarium", "governance_ablation"]},
        "independent_histories": {"type": "integer", "minimum": 1},
        "paired_difference": {"type": "number", "minimum": -1, "maximum": 1},
        "paired_bootstrap_95": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -1, "maximum": 1}},
        "model_quality_qualified": {"const": false},
        "paired_history_differences": {"type": "array", "minItems": 1, "items": {"enum": [-1, 0, 1]}}
      }
    },
    "calibration": {"type": "object", "required": ["retrieval", "ledger_append", "cold_readiness"]}
  },
  "$defs": {"identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
