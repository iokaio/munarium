{
  "$comment": "SPDX-License-Identifier: Apache-2.0. Seed for the local v1.4 compatibility harness. Run once against the published v1.4.0 binary on an empty PostgreSQL database; the database is then copied so both binaries replay against identical v1.4-written state. All text is fictional. Variables: ${stub_url} (the counting provider stub) and ${pdf_b64} (a generated one-page PDF).",
  "cases": [
    {"id": "seed-version", "method": "POST", "path": "/v1/versions", "headers": {"Idempotency-Key": "seed-0001"}, "json": {}, "expect_status": [200, 201], "capture": {"version_id": "/version_id"}},
    {"id": "seed-claim-1", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${version_id}"}, "headers": {"Idempotency-Key": "seed-0002"}, "json": {"claim_type": "fact", "subject": "starter", "key": "purpose", "value": "corpus evaluation"}, "expect_status": [200, 201], "capture": {"claim_1": "/claim/id"}},
    {"id": "seed-claim-2", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${version_id}"}, "headers": {"Idempotency-Key": "seed-0003"}, "json": {"claim_type": "fact", "subject": "starter", "key": "owner", "value": "billing team", "scope_path": "dept/billing"}, "expect_status": [200, 201], "capture": {"claim_2": "/claim/id"}},
    {"id": "seed-claim-correction", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${version_id}"}, "headers": {"Idempotency-Key": "seed-0004"}, "json": {"claim_type": "correction", "subject": "starter", "key": "owner", "value": "account support team", "scope_path": "dept/billing", "supersedes_id": "${claim_2}"}, "expect_status": [200, 201], "capture": {"claim_3": "/claim/id"}},
    {"id": "seed-promise", "method": "POST", "path": "/v1/versions/{version_id}/promises", "params": {"version_id": "${version_id}"}, "headers": {"Idempotency-Key": "seed-0005"}, "json": {"key": "follow-up", "kind": "task", "description": "send the summary"}, "expect_status": [200, 201]},
    {"id": "seed-anchor", "method": "POST", "path": "/v1/versions/{version_id}/anchors", "params": {"version_id": "${version_id}"}, "headers": {"Idempotency-Key": "seed-0006"}, "json": {"subject": "starter", "key": "region", "value": "north"}, "expect_status": [200, 201]},
    {"id": "seed-counter", "method": "POST", "path": "/v1/versions/{version_id}/counters", "params": {"version_id": "${version_id}"}, "headers": {"Idempotency-Key": "seed-0007"}, "json": {"key": "tickets", "scope_path": "dept/billing", "count": 3, "budget": 10}, "expect_status": [200, 201]},
    {"id": "seed-shape-text", "method": "POST", "path": "/v1/shapes", "content_type": "text/yaml", "text": "apiVersion: munarium.ioka.io/v1\nkind: Shape\nmetadata: { name: starter-documents, version: 1 }\nspec:\n  chunking: { strategy: para@1, max_chars: 800 }\n  indexing: { rrf_k: 60, candidate_n: 50 }\n", "expect_status": [200, 201]},
    {"id": "seed-shape-pdf", "method": "POST", "path": "/v1/shapes", "content_type": "text/yaml", "text": "apiVersion: munarium.ioka.io/v1\nkind: Shape\nmetadata: { name: starter-pdfs, version: 1 }\nspec:\n  chunking: { strategy: para@1, max_chars: 800 }\n  indexing: { rrf_k: 60, candidate_n: 50 }\n", "expect_status": [200, 201]},
    {"id": "seed-provider", "method": "POST", "path": "/v1/providers", "content_type": "text/yaml", "text": "apiVersion: munarium.ioka.io/v1\nkind: ProviderConfig\nmetadata: { name: compat-stub }\nspec:\n  provider: ollama\n  endpoint: ${stub_url}\n  models:\n    complete: [stub-model:1]\n    embed: [stub-model:1]\n    fast: stub-model:1\n    capable: stub-model:1\n  budgets: { rpm: 600, tpm: 1000000 }\n", "expect_status": [200, 201]},
    {"id": "seed-runbook", "method": "POST", "path": "/v1/runbooks", "content_type": "text/yaml", "text": "apiVersion: munarium.ioka.io/v1\nkind: Runbook\nmetadata: { name: starter, version: 1 }\nspec:\n  sources: { prefix: \"starter/\" }\n  collections:\n    - name: starter-documents\n      shape: starter-documents@1\n      accessLevel: 0\n      sources: { filenamePrefix: \"starter/\", mediaTypes: [text/plain] }\n    - name: starter-pdfs\n      shape: starter-pdfs@1\n      accessLevel: 0\n      sources: { filenamePrefix: \"starter/\", mediaTypes: [application/pdf] }\n  retrieval: { topK: 4, rrfK: 60, candidateN: 50 }\n  models:\n    default: { provider: compat-stub, tier: fast }\n    tasks:\n      completion: { provider: compat-stub, tier: fast }\n  completion:\n    contextCharBudget: 4000\n    maxTokens: 256\n    promptTemplate: |\n      Answer only from the supplied evidence.\n      Context: {context}\n      Question: {query}\n  steps:\n    - resolveSources: {}\n    - buildIndex: {}\n    - verify: {}\n    - cutover: { approval: required }\n    - retireOld: { keep_versions: 2 }\n", "expect_status": [200, 201]},
    {"id": "seed-ingest-billing", "method": "POST", "path": "/v1/ingest", "json": {"filename": "starter/billing.txt", "media_type": "text/plain", "content_base64": "RXhhbXBsZVdvcmtzIGludm9pY2UgcXVlc3Rpb25zIGFyZSBoYW5kbGVkIGJ5IHRoZSBiaWxsaW5nIHRlYW0uIEluY2x1ZGUgdGhlIGludm9pY2UgbnVtYmVyIGluIHlvdXIgcmVxdWVzdC4="}, "expect_status": [200, 201], "capture": {"source_billing": "/source_id"}},
    {"id": "seed-ingest-accounts", "method": "POST", "path": "/v1/ingest", "json": {"filename": "starter/accounts.txt", "media_type": "text/plain", "content_base64": "RXhhbXBsZVdvcmtzIGFjY291bnQgYWNjZXNzIHF1ZXN0aW9ucyBhcmUgaGFuZGxlZCBieSB0aGUgYWNjb3VudCBzdXBwb3J0IHRlYW0u"}, "expect_status": [200, 201], "capture": {"source_accounts": "/source_id"}},
    {"id": "seed-ingest-pdf", "method": "POST", "path": "/v1/ingest", "json": {"filename": "starter/handbook.pdf", "media_type": "application/pdf", "content_base64": "${pdf_b64}"}, "expect_status": [200, 201], "capture": {"source_pdf": "/source_id"}},
    {"id": "seed-run", "method": "POST", "path": "/v1/runbooks/{name}/runs", "params": {"name": "starter"}, "expect_status": [200, 201, 202], "capture": {"run_id": "/run_id"}},
    {"id": "seed-run-wait", "method": "GET", "path": "/v1/runs/{run_id}", "params": {"run_id": "${run_id}"}, "poll": {"pointer": "/state", "until": ["awaiting_approval", "done", "failed"], "interval": 1, "max": 120}, "expect_status": 200, "capture_where": {"cutover_text": {"array": "/steps", "match": {"name": "cutover:starter-documents", "state": "awaiting_approval"}, "field": "ordinal"}}},
    {"id": "seed-approve-text", "method": "POST", "path": "/v1/runs/{run_id}/steps/{ordinal}/approve", "params": {"run_id": "${run_id}", "ordinal": "${cutover_text}"}, "expect_status": [200, 201, 202]},
    {"id": "seed-run-wait-2", "method": "GET", "path": "/v1/runs/{run_id}", "params": {"run_id": "${run_id}"}, "poll": {"pointer": "/state", "until": ["awaiting_approval", "done", "failed"], "interval": 1, "max": 120}, "expect_status": 200, "capture_where": {"cutover_pdf": {"array": "/steps", "match": {"name": "cutover:starter-pdfs", "state": "awaiting_approval"}, "field": "ordinal"}}},
    {"id": "seed-approve-pdf", "method": "POST", "path": "/v1/runs/{run_id}/steps/{ordinal}/approve", "params": {"run_id": "${run_id}", "ordinal": "${cutover_pdf}"}, "expect_status": [200, 201, 202]},
    {"id": "seed-run-done", "method": "GET", "path": "/v1/runs/{run_id}", "params": {"run_id": "${run_id}"}, "poll": {"pointer": "/state", "until": ["done", "failed"], "interval": 1, "max": 120}, "expect_status": 200, "capture": {"run_state": "/state"}},
    {"id": "seed-collections", "method": "GET", "path": "/v1/collections", "expect_status": 200, "capture_where": {"coll_text": {"array": "/collections", "match": {"name": "starter-documents"}, "field": "id"}, "coll_pdf": {"array": "/collections", "match": {"name": "starter-pdfs"}, "field": "id"}, "idx_text": {"array": "/collections", "match": {"name": "starter-documents"}, "field": "active_index"}, "idx_pdf": {"array": "/collections", "match": {"name": "starter-pdfs"}, "field": "active_index"}}},
    {"id": "seed-session", "method": "POST", "path": "/v1/runbooks/{name}/sessions", "params": {"name": "starter@1"}, "expect_status": [200, 201], "capture": {"session_id": "/session_id"}},
    {"id": "seed-turn", "method": "POST", "path": "/v1/sessions/{id}/turns", "params": {"id": "${session_id}"}, "json": {"query": "Who handles invoice questions?", "complete": false}, "expect_status": 200},
    {"id": "seed-token", "method": "POST", "path": "/v1/access-tokens", "token": "mgmt", "json": {"uid": "compat-user", "access_level": 1, "scopes": ["query", "ingest"], "compartments": []}, "expect_status": [200, 201], "capture": {"cap_token": "/token", "cap_jti": "/jti"}},
    {"id": "seed-token-revocable", "method": "POST", "path": "/v1/access-tokens", "token": "mgmt", "json": {"uid": "compat-revoke", "access_level": 0, "scopes": ["query"], "compartments": []}, "expect_status": [200, 201], "capture": {"revoke_jti": "/jti"}}
  ]
}
