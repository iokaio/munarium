    {"id": "ledger-claim", "method": "GET", "path": "/v1/claims/{claim_id}", "params": {"claim_id": "${claim_1}"}, "expect_status": 200},
    {"id": "ledger-claim-superseded", "method": "GET", "path": "/v1/claims/{claim_id}", "params": {"claim_id": "${claim_2}"}, "expect_status": 200},
    {"id": "ledger-claim-missing", "kind": "refusal", "method": "GET", "path": "/v1/claims/{claim_id}", "params": {"claim_id": "claim-00000000000000000000000000000000"}, "expect_status": 404},
    {"id": "ledger-lineage", "method": "GET", "path": "/v1/versions/{version_id}/lineage", "params": {"version_id": "${version_id}"}, "expect_status": 200},
    {"id": "ledger-context", "method": "GET", "path": "/v1/versions/{version_id}/context", "params": {"version_id": "${version_id}"}, "exact": true, "expect_status": 200},
    {"id": "ledger-context-budget", "method": "GET", "path": "/v1/versions/{version_id}/context", "params": {"version_id": "${version_id}"}, "query": {"budget_tokens": 12}, "exact": true, "expect_status": 200},
