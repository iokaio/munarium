    {"id": "session-turn-stream", "kind": "streaming", "method": "POST", "path": "/v1/sessions/{id}/turns/stream", "params": {"id": "${rs}"}, "json": {"query": "Who handles invoice questions?", "complete": false}, "stream": true, "expect_status": 200},
    {"id": "session-turn-complete", "method": "POST", "path": "/v1/sessions/{id}/turns", "params": {"id": "${rs}"}, "json": {"query": "Who handles invoice questions?", "complete": true}, "expect_status": 200},
    {"id": "session-turn-stream-complete", "kind": "streaming", "method": "POST", "path": "/v1/sessions/{id}/turns/stream", "params": {"id": "${rs}"}, "json": {"query": "Who handles account access?", "complete": true}, "stream": true, "expect_status": 200},
    {"id": "session-turn-unknown-profile", "kind": "refusal", "method": "POST", "path": "/v1/sessions/{id}/turns", "params": {"id": "${rs}"}, "json": {"query": "x", "complete": false, "research_profile": "no-such-profile"}},
    {"id": "session-turn-stream-refusal", "kind": "streaming", "method": "POST", "path": "/v1/sessions/{id}/turns/stream", "params": {"id": "${rs}"}, "json": {"query": "x", "complete": false, "research_profile": "no-such-profile"}, "stream": true},
