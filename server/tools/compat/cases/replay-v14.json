    {"id": "retrieval-index", "kind": "refusal", "method": "GET", "path": "/v1/indexes/{shape_ref}", "params": {"shape_ref": "starter-documents@1"}, "expect_status": 404},
    {"id": "retrieval-index-pdf", "kind": "refusal", "method": "GET", "path": "/v1/indexes/{shape_ref}", "params": {"shape_ref": "starter-pdfs@1"}, "expect_status": 404},
