    {"id": "write-version", "method": "POST", "path": "/v1/versions", "headers": {"Idempotency-Key": "rp-${run}-01"}, "json": {"parent_version_id": "${version_id}"}, "expect_status": 200, "capture": {"child_version": "/version_id"}},
    {"id": "write-claim", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-02"}, "json": {"claim_type": "fact", "subject": "replay", "key": "status", "value": "green"}, "expect_status": 200, "capture": {"child_claim": "/claim/id", "child_head": "/head_seq"}},
    {"id": "write-claim-idempotent-replay", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-02"}, "json": {"claim_type": "fact", "subject": "replay", "key": "status", "value": "green"}, "expect_status": 200},
    {"id": "write-claim-idempotency-mismatch", "kind": "conflict", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-02"}, "json": {"claim_type": "fact", "subject": "replay", "key": "status", "value": "red"}},
    {"id": "write-claim-head-conflict", "kind": "conflict", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-03"}, "json": {"expected_head": 0, "claim_type": "fact", "subject": "replay", "key": "status", "value": "amber"}, "expect_status": 409},
    {"id": "write-claim-expected-head-ok", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-04"}, "json": {"expected_head": "${child_head}", "claim_type": "update", "subject": "replay", "key": "status", "value": "amber", "supersedes_id": "${child_claim}"}, "expect_status": 200},
    {"id": "write-claim-gate-disputed", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${version_id}"}, "headers": {"Idempotency-Key": "rp-${run}-05"}, "json": {"claim_type": "fact", "subject": "starter", "key": "region", "value": "south"}, "expect_status": 200},
    {"id": "write-claim-bad-enum", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-06"}, "json": {"claim_type": "opinion", "subject": "replay", "key": "k", "value": "v"}},
    {"id": "write-claim-missing-field", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-07"}, "json": {"claim_type": "fact", "subject": "replay"}},
    {"id": "write-claim-malformed-json", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-08"}, "content_type": "application/json", "text": "{\"claim_type\": "},
    {"id": "write-claim-explicit-null-scope", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-09"}, "json": {"claim_type": "fact", "subject": "replay", "key": "nullscope", "value": "v", "scope_path": null, "provenance": null}, "expect_status": 200},
    {"id": "write-claim-ro-role", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "token": "ro", "headers": {"Idempotency-Key": "rp-${run}-10"}, "json": {"claim_type": "fact", "subject": "replay", "key": "k", "value": "v"}},
    {"id": "write-claim-no-token", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "token": "none", "headers": {"Idempotency-Key": "rp-${run}-11"}, "json": {"claim_type": "fact", "subject": "replay", "key": "k", "value": "v"}, "expect_status": 401},
    {"id": "write-claim-bad-token", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "token": "not-a-registered-token", "headers": {"Idempotency-Key": "rp-${run}-12"}, "json": {"claim_type": "fact", "subject": "replay", "key": "k", "value": "v"}, "expect_status": 401},
    {"id": "write-claim-no-uid", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "uid": "", "headers": {"Idempotency-Key": "rp-${run}-13"}, "json": {"claim_type": "fact", "subject": "replay", "key": "k", "value": "v"}},
    {"id": "write-claim-no-idempotency-key", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "json": {"claim_type": "fact", "subject": "replay", "key": "k", "value": "v"}},
    {"id": "write-claim-unknown-member", "method": "POST", "path": "/v1/versions/{version_id}/claims", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-14"}, "json": {"claim_type": "fact", "subject": "replay", "key": "unknown-member", "value": "v", "future_member": {"x": 1}}, "expect_status": 200},
    {"id": "write-promise-fulfill", "method": "POST", "path": "/v1/versions/{version_id}/promises/{key}/fulfill", "params": {"version_id": "${child_version}", "key": "follow-up"}, "headers": {"Idempotency-Key": "rp-${run}-15"}},
    {"id": "write-counter", "method": "POST", "path": "/v1/versions/{version_id}/counters", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-16"}, "json": {"key": "tickets", "scope_path": "dept/billing", "count": 2}, "expect_status": 200},
    {"id": "write-counter-u64-max", "kind": "refusal", "method": "POST", "path": "/v1/versions/{version_id}/counters", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-17"}, "content_type": "application/json", "text": "{\"key\":\"big\",\"scope_path\":\"x\",\"count\":18446744073709551615}"},
    {"id": "write-anchor", "method": "POST", "path": "/v1/versions/{version_id}/anchors", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-18"}, "json": {"subject": "replay", "key": "anchor", "value": "fixed"}, "expect_status": 200},
    {"id": "write-digest", "method": "PUT", "path": "/v1/versions/{version_id}/digests", "params": {"version_id": "${child_version}"}, "headers": {"Idempotency-Key": "rp-${run}-19"}, "json": {"version_id": "${child_version}", "scope_path": "dept/billing", "tier": 1, "text": "Billing summary."}},
