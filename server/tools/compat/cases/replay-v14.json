    {"id": "rebuild-run", "method": "POST", "path": "/v1/runbooks/{name}/runs", "params": {"name": "starter"}, "capture": {"run2": "/run_id"}},
    {"id": "rebuild-wait", "method": "GET", "path": "/v1/runs/{run_id}", "params": {"run_id": "${run2}"}, "poll": {"pointer": "/state", "until": ["awaiting_approval", "done", "failed"], "interval": 1, "max": 120}, "capture_where": {"run2_cut_text": {"array": "/steps", "match": {"name": "cutover:starter-documents", "state": "awaiting_approval"}, "field": "ordinal"}}},
    {"id": "rebuild-approve-text", "method": "POST", "path": "/v1/runs/{run_id}/steps/{ordinal}/approve", "params": {"run_id": "${run2}", "ordinal": "${run2_cut_text}"}},
    {"id": "rebuild-wait-2", "method": "GET", "path": "/v1/runs/{run_id}", "params": {"run_id": "${run2}"}, "poll": {"pointer": "/state", "until": ["awaiting_approval", "done", "failed"], "interval": 1, "max": 120}, "capture_where": {"run2_cut_pdf": {"array": "/steps", "match": {"name": "cutover:starter-pdfs", "state": "awaiting_approval"}, "field": "ordinal"}}},
    {"id": "rebuild-approve-pdf", "method": "POST", "path": "/v1/runs/{run_id}/steps/{ordinal}/approve", "params": {"run_id": "${run2}", "ordinal": "${run2_cut_pdf}"}},
    {"id": "rebuild-done", "method": "GET", "path": "/v1/runs/{run_id}", "params": {"run_id": "${run2}"}, "poll": {"pointer": "/state", "until": ["done", "failed"], "interval": 1, "max": 120}},
    {"id": "rebuild-collections", "method": "GET", "path": "/v1/collections"},
    {"id": "rebuild-search-text", "method": "POST", "path": "/v1.2/search", "json": {"query": "Who handles shipping questions?", "collection": "starter-documents", "top_k": 4}},
    {"id": "rebuild-search-pdf", "method": "POST", "path": "/v1.2/search", "json": {"query": "Who handles hardware returns?", "collection": "starter-pdfs", "top_k": 4}},
    {"id": "rebuild-search-old-index", "method": "POST", "path": "/v1.2/search", "json": {"query": "Who handles shipping questions?", "collection": "starter-documents", "index_version": "${idx_text}", "top_k": 4}},
    {"id": "rebuild-index", "method": "GET", "path": "/v1/indexes/{shape_ref}", "params": {"shape_ref": "starter-documents@1"}},

    {"id": "reports-sessions", "method": "GET", "path": "/v1/reports/sessions", "token": "mgmt"},
    {"id": "reports-runbooks", "method": "GET", "path": "/v1/reports/runbooks", "token": "mgmt"},
    {"id": "reports-matrix-unconfigured", "method": "GET", "path": "/v1/reports/matrix", "token": "mgmt"},
    {"id": "reports-audit-page", "method": "GET", "path": "/v1/reports/audit", "token": "mgmt", "query": {"limit": 2}},
    {"id": "reports-rw-refused", "kind": "refusal", "method": "GET", "path": "/v1/reports/sessions"},
    {"id": "config-max-tokens", "method": "GET", "path": "/v1/max-tokens", "token": "mgmt"},
    {"id": "config-command-recovery", "method": "GET", "path": "/v1/command-recovery", "token": "mgmt"},
    {"id": "config-source-retention", "method": "GET", "path": "/v1/source-retention", "token": "mgmt"},
    {"id": "jobs-list", "method": "GET", "path": "/v1/index-build-jobs", "token": "mgmt"},
    {"id": "rollout-get", "method": "GET", "path": "/v1/retrieval-rollout/{scope_kind}/{scope_id}", "token": "mgmt", "params": {"scope_kind": "collection", "scope_id": "${coll_text}"}},
    {"id": "unknown-route", "kind": "refusal", "method": "GET", "path": "/v1/no-such-route", "skip_transports": ["bridge"]}
  ]
}
