    {"id": "ledger-context-as-of-date", "kind": "refusal", "method": "GET", "path": "/v1/versions/{version_id}/context", "params": {"version_id": "${version_id}"}, "query": {"as_of_date": "2026-01-01"}},
    {"id": "ledger-anchors", "method": "GET", "path": "/v1/versions/{version_id}/anchors", "params": {"version_id": "${version_id}"}, "expect_status": 200},
    {"id": "ledger-counters", "method": "GET", "path": "/v1/versions/{version_id}/counters", "params": {"version_id": "${version_id}"}, "expect_status": 200},
    {"id": "ledger-promises", "method": "GET", "path": "/v1/versions/{version_id}/promises", "params": {"version_id": "${version_id}"}, "expect_status": 200},
    {"id": "ledger-digests-empty", "method": "GET", "path": "/v1/versions/{version_id}/digests", "params": {"version_id": "${version_id}"}, "expect_status": 200},
