{
  "$comment": "SPDX-License-Identifier: Apache-2.0. COMPAT-T1 replay cases for v1.4 operations. Each case runs in order against one binary; ${run} separates transports so the REST and native-bridge passes do not collide. kind is success, refusal, conflict or streaming. exact asks for byte-identical bodies. volatile lists JSON paths (from the transcript root, for example /json/x) whose values may differ while their JSON kind may not. Paths use the v1.4 server_api.proto templates so the native bridge can route them.",
  "cases": [
    {"id": "health-healthz", "method": "GET", "path": "/healthz", "token": "none", "uid": "", "exact": true, "expect_status": 200},
    {"id": "health-readyz", "method": "GET", "path": "/readyz", "token": "none", "uid": "", "expect_status": 200},
    {"id": "meta-version", "method": "GET", "path": "/version", "token": "none", "uid": "", "expect_status": 200},

    {"id": "ledger-head", "method": "GET", "path": "/v1/versions/{version_id}/head", "params": {"version_id": "${version_id}"}, "expect_status": 200},
    {"id": "ledger-facts", "method": "GET", "path": "/v1/versions/{version_id}/facts", "params": {"version_id": "${version_id}"}, "expect_status": 200},
    {"id": "ledger-facts-pinned", "method": "GET", "path": "/v1/versions/{version_id}/facts", "params": {"version_id": "${version_id}"}, "query": {"as_of_seq": 2}, "expect_status": 200},
